# Data files stay local by default. To publish one, add a "!file.csv" line at the end of this
# file and list the same path in ALLOWLIST.txt.
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
*.zip
*.gz
*.npy
*.npz
*.pkl
*.pickle
*.h5
*.hdf5
data/*
datasets/

# Run outputs, rebuilt by every run of the notebook: checkpoints and saved figures
outputs/

# Model weights
*.pt
*.pth
*.ckpt
*.safetensors

# Environments and secrets
.venv/
venv/
env/
.env
.env.*

# Jupyter and Python caches
.ipynb_checkpoints/
__pycache__/
*.pyc

# Office lock files and system noise
~$*
.~lock.*
.DS_Store
Thumbs.db

# PDF files are not ignored: the report PDF is a deliverable.
!data/manifest_fixed_20261013.csv
# The submitted checkpoints: run 1's EMA generator at epoch 100 and its discriminator.
!models/generator_ema.pt
!models/discriminator.pt
